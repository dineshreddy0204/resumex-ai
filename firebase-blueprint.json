{
  "entities": {
    "User": {
      "title": "User",
      "description": "ResumeX user authentication reference record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "description": "User email address" },
        "name": { "type": "string", "description": "User display name" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and metadata document"
    }
  }
}
