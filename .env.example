# ==============================================================================
# ResumeX AI — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# PRIVATE VARIABLES (Server-side ONLY — Never expose to browser / client bundles)
# ------------------------------------------------------------------------------

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# Base URL where this application is hosted (e.g. https://resumex.example.com)
APP_URL=

# PostgreSQL Database Connection URL (e.g. postgresql://user:password@localhost:5432/resumex)
DATABASE_URL=

# Cryptographic Secret for signing HttpOnly JWT session cookies (HMAC SHA-256)
JWT_SECRET=

# Google Gemini API key for server-side AI evaluation & suggestions
GEMINI_API_KEY=

# Centralized Gemini Model Identifier (e.g. gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Centralized Gemini Embedding Model Identifier (e.g. text-embedding-004)
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Google OAuth Client ID for server-side cryptographic ID token verification
# Must match VITE_GOOGLE_CLIENT_ID and be created as an OAuth 2.0 Web Application client
GOOGLE_CLIENT_ID=

# SMTP Email Configuration for password reset & email verification
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@resumex.ai

# Demo login toggle (Strictly false by default; must remain false in production)
ENABLE_DEMO_LOGIN=false

# ------------------------------------------------------------------------------
# PUBLIC VARIABLES (Client-side accessible via Vite import.meta.env)
# ------------------------------------------------------------------------------

# Public Google OAuth Client ID for Google Identity Services popup button
# CRITICAL: This Web Client ID must have all deployment domains registered in
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# under "Authorized JavaScript origins":
#   1. Deployed Dev URL: https://ais-dev-dt5aowrk4fi45sk7wqb4p5-168252918909.asia-east1.run.app
#   2. Deployed Preview URL: https://ais-pre-dt5aowrk4fi45sk7wqb4p5-168252918909.asia-east1.run.app
#   3. Local Development URL: http://localhost:3000
# NOTE:
#   - Do NOT include trailing slashes (e.g., use https://domain.run.app, not https://domain.run.app/)
#   - Do NOT include paths (e.g., do NOT add /login or /auth/callback as an origin)
#   - Do NOT use wildcards (Google Cloud Console does not support *.run.app)
#   - Do NOT add accounts.google.com as an origin
VITE_GOOGLE_CLIENT_ID=


