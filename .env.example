# ==============================================================================
# ResumeX AI — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# PRIVATE VARIABLES (Server-side ONLY — Never expose to browser / client bundles)
# ------------------------------------------------------------------------------

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# Base URL where this application is hosted (e.g. https://resumex.example.com)
APP_URL=

# PostgreSQL Database Connection URL (e.g. postgresql://user:password@localhost:5432/resumex)
DATABASE_URL=

# Cryptographic Secret for signing HttpOnly JWT session cookies (HMAC SHA-256)
JWT_SECRET=

# Google Gemini API key for server-side AI evaluation & suggestions
GEMINI_API_KEY=

# Centralized Gemini Model Identifier (e.g. gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Centralized Gemini Embedding Model Identifier (e.g. text-embedding-004)
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Google OAuth Client ID for server-side cryptographic ID token verification
GOOGLE_CLIENT_ID=

# SMTP Email Configuration for password reset & email verification
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@resumex.ai

# Demo login toggle (Strictly false by default; must remain false in production)
ENABLE_DEMO_LOGIN=false

# ------------------------------------------------------------------------------
# PUBLIC VARIABLES (Client-side accessible via Vite import.meta.env)
# ------------------------------------------------------------------------------

# Public Google OAuth Client ID for Google Identity Services popup button
VITE_GOOGLE_CLIENT_ID=


